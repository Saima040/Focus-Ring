    "verify": "node tools/verify.js",
    "e2e": "node tools/e2e.js",
    "test": "node tools/verify.js && node tools/e2e.js",
    "levels": "node tools/export-levels.js",
    "shots": "node tools/screenshots.js"
  },
  "engines": { "node": ">=18" },
